.git/
.gitignore

# Exclude local build artifacts to avoid stale absolute CMake paths in image.
cpp/build/
**/CMakeCache.txt
**/CMakeFiles/
**/*.o
**/*.so
**/*.a

# Rebuild ONNX/engine inside the image (avoid baking stale host exports).
models/*.onnx
models/*.engine

# Drop heavy non-essential outputs inside vendored YOSO sources.
vendor/yoso/**/output/
vendor/yoso/**/__pycache__/
